{
  "expo": {
    "name": "AI Systems",
    "slug": "ai-systems",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "famashines-ai",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.famashines.ai",
      "predictiveBackGestureEnabled": true,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FB",
          "dark": {
            "backgroundColor": "#111318"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
