{
  "name": "ai-systems-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint && node scripts/no-comments.js",
    "typecheck": "tsc --noEmit",
    "contrast": "jest src/theme.test.ts",
    "test": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "expo": "~58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest-expo": "~58.0.13",
    "react-dom": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  }
}
